DATABASE_URL=sqlite:data/sqlite.db

# Server Configuration
SERVER_HOST=127.0.0.1
SERVER_PORT=8080

# JWT Configuration
# SECURITY WARNING: Change these default values in production!
# Generate a strong secret with: openssl rand -base64 32
JWT_SECRET=change-me-openssl-rand-base64-32
JWT_EXPIRES_IN=86400  # 24 hours
JWT_ISSUER=admin-server

# Token Configuration
# SECURITY WARNING: Change this default value in production!
# Generate a strong secret with: openssl rand -base64 64
TOKEN_SECRET=change-me-openssl-rand-base64-64

# CORS Configuration
# SECURITY WARNING: Do not use '*' in production! Specify exact origins.
# Example: CORS_ORIGIN=https://yourdomain.com,https://admin.yourdomain.com
CORS_ORIGIN=*
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_HEADERS=*

# Logging
RUST_LOG=debug
LOG_FILE_LEVEL=debug
RUST_BACKTRACE=1

# Cookie Security
# IMPORTANT: Enable these in production for security!
COOKIE_HTTP_ONLY=true
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Security Configuration
SUPER_ADMIN_ROLES=super_admin,system_admin
SUPER_ADMIN_ROLE_IDS=1
REQUIRE_MFA_FOR_ADMIN=false
# ALLOWED_PERMISSION_PATTERNS=^[a-z_]+\.[a-z_]+$
LOG_REDACTION_FIELDS=password,token,secret,api_key,auth_token

# Access Control Configuration
ACCESS_CONTROL_MODE=hybrid
ACCESS_CONTROL_COMBINATION_STRATEGY=either_allowed
ACCESS_CONTROL_CONFLICT_RESOLUTION=deny_overrides
ACCESS_CONTROL_ENABLE_CACHING=true
ACCESS_CONTROL_CACHE_TTL_SECONDS=300
ACCESS_CONTROL_MAX_EVALUATION_TIME_MS=100
ACCESS_CONTROL_ENABLE_AUDIT_LOGGING=true
