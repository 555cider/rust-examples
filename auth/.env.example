AUTH_SERVER_BIND_ADDR=127.0.0.1:3000
AUTH_SERVER_DATABASE_URL=postgres://auth_server:auth_server@127.0.0.1:25432/auth_server
AUTH_SERVER_DATABASE_MAX_CONNECTIONS=10
AUTH_SERVER_ISSUER=http://127.0.0.1:3000
# Optional on loopback/local runs. Non-local deployments should provide a PKCS#8 Ed25519 private key path.
# AUTH_SERVER_SIGNING_KEY_PATH=./dev/keys/auth-server-ed25519.pem
RUST_LOG=auth_server=info,tower_http=info
